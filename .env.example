# ==========================================
# CONFIGURACIÓN DEL PROYECTO (FaceSentinel)
# Plantilla de variables de entorno (.env.example)
# ==========================================

# 1. Configuración de la API (FastAPI)
PROJECT_NAME="FaceSentinel"
API_V1_STR="/api/v1"
CORS_ORIGINS="http://localhost:8088,http://localhost:5173"

# 2. Rutas de Bases de Datos Locales
SQLITE_DB_PATH="./data/sql/database.db"
CHROMA_DB_PATH="./data/chromadb"
TEMP_IMAGES_PATH="./data/temp_images"

# 3. Credenciales Iniciales de Administrador (Sembrado automático si la BD está vacía)
INITIAL_ADMIN_ID="ADMIN001"
INITIAL_ADMIN_USERNAME="admin"
INITIAL_ADMIN_NAME="Administrador del Sistema"
INITIAL_ADMIN_PASSWORD="change_this_admin_password_in_production"

# 4. Configuración de Inteligencia Artificial (DeepFace / ArcFace)
AI_MODEL_NAME="ArcFace" 
FACE_MATCH_THRESHOLD=0.68 

# 5. Configuración de Blockchain (Web3)
# Para ejecución local fuera de Docker: "http://127.0.0.1:7545"
# Para ejecución dentro de Docker Compose hacia host: "http://host.docker.internal:7545"
BLOCKCHAIN_RPC_URL="http://127.0.0.1:7545"
CHAIN_ID=1337
SMART_CONTRACT_ADDRESS=""
DEVICE_PRIVATE_KEY=""

WEB3_PROVIDER_URI="http://127.0.0.1:7545"
# Cuenta y llave privada de prueba predeterminadas de Ganache (Cuenta 0 con balance inicial de 1000 ETH)
ADMIN_ADDRESS="0x90F8bf6A479f320ead074411a4B0e7944Ea8c9C1"
ADMIN_PRIVATE_KEY="0x4f3edf983ac636a65a842ce7c78d9aa706d3b113bce9c46f30d7d21715b23b1d"

# 6. Seguridad M2M (Acceso Físico / Dispositivos IoT)
HW_CLIENT_SECRET="change-this-secret-in-production"

# 7. Seguridad — JWT y Rate Limiting
JWT_SECRET_KEY="facesentinel-super-secret-key-change-in-production"
JWT_EXPIRATION_MINUTES=1440
RATE_LIMIT_PER_MINUTE=30
